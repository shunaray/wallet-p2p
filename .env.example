# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual credentials.
#
# Used by: docker compose -f docker-compose.yml -f docker-compose.neon.yml up

#  Any PostgreSQL connection details
DB_URL=jdbc:postgresql://<host>/<dbname>?sslmode=require&channel_binding=require
DB_USER=<username>
DB_PASSWORD=<password>
